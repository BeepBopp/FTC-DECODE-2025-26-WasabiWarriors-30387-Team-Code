package org.firstinspires.ftc.teamcode;

import com.qualcomm.hardware.limelightvision.LLResult;
import com.qualcomm.hardware.limelightvision.Limelight3A;
import com.qualcomm.hardware.rev.RevHubOrientationOnRobot;
import com.qualcomm.robotcore.eventloop.opmode.OpMode;
import com.qualcomm.robotcore.eventloop.opmode.TeleOp;
import com.qualcomm.robotcore.hardware.DcMotor;
import com.qualcomm.robotcore.hardware.DcMotorSimple;
import com.qualcomm.robotcore.hardware.IMU;
import com.qualcomm.robotcore.util.Range;

import org.firstinspires.ftc.robotcore.external.navigation.AngleUnit;
import org.firstinspires.ftc.robotcore.external.navigation.YawPitchRollAngles;

@TeleOp(name = "Decode Aim: 10 Deg Offset")
public class DecodeSmartAim extends OpMode {

    private DcMotor leftFront, rightFront, leftBack, rightBack;
    private Limelight3A limelight;
    private IMU imu;

    // --- TUNING ---
    private final double AUTO_TURN_LIMIT = 0.20; 
    private final double TURN_GAIN = 0.025;      
    private final double TURN_DEADZONE = 1.0;    // 1 degree tolerance
    
    // --- OFFSET SETTING ---
    // 0 = Head on. 10 = Robot looks 10 degrees to the left of the tag.
    private final double TARGET_TX_OFFSET = 3.0; 

    @Override
    public void init() {
        leftFront  = hardwareMap.get(DcMotor.class, "leftFront");
        rightFront = hardwareMap.get(DcMotor.class, "rightFront");
        leftBack   = hardwareMap.get(DcMotor.class, "leftBack");
        rightBack  = hardwareMap.get(DcMotor.class, "rightBack");

        leftFront.setDirection(DcMotorSimple.Direction.REVERSE);
        leftBack.setDirection(DcMotorSimple.Direction.REVERSE);

        // Brake Mode
        leftFront.setZeroPowerBehavior(DcMotor.ZeroPowerBehavior.BRAKE);
        rightFront.setZeroPowerBehavior(DcMotor.ZeroPowerBehavior.BRAKE);
        leftBack.setZeroPowerBehavior(DcMotor.ZeroPowerBehavior.BRAKE);
        rightBack.setZeroPowerBehavior(DcMotor.ZeroPowerBehavior.BRAKE);

        limelight = hardwareMap.get(Limelight3A.class, "limelight");
        limelight.pipelineSwitch(0); 
        limelight.start(); 

        imu = hardwareMap.get(IMU.class, "imu");
        imu.initialize(new IMU.Parameters(new RevHubOrientationOnRobot(
                RevHubOrientationOnRobot.LogoFacingDirection.UP,
                RevHubOrientationOnRobot.UsbFacingDirection.LEFT))); 
    }

    @Override
    public void loop() {
        YawPitchRollAngles orientation = imu.getRobotYawPitchRollAngles();
        limelight.updateRobotOrientation(orientation.getYaw(AngleUnit.DEGREES)); 
        
        LLResult result = limelight.getLatestResult(); 

        double drive = 0;
        double strafe = 0;
        double turn = 0;

        if (gamepad1.a && result != null && result.isValid()) {
            
            double tx = result.getTx(); 
            // Calculate error relative to our 10-degree target
            double error = tx - TARGET_TX_OFFSET;

            if (Math.abs(error) > TURN_DEADZONE) {
                turn = Range.clip(error * TURN_GAIN, -AUTO_TURN_LIMIT, AUTO_TURN_LIMIT);
            } else {
                // --- LOCKED ON FEEDBACK ---
                turn = 0; 
                gamepad1.rumble(100); // Short vibrate
            }

            telemetry.addData("Status", "AUTO AIMING (Target: 10° CCW)");
            telemetry.addData("Current Error", error);

        } else {
            // MANUAL DRIVE
            drive  = -gamepad1.left_stick_y;
            strafe = gamepad1.left_stick_x;
            turn   = -gamepad1.right_stick_x;
            telemetry.addData("Status", "MANUAL DRIVE");
        }

        // Apply Motor Power
        double max = Math.max(Math.abs(drive) + Math.abs(strafe) + Math.abs(turn), 1);
        leftFront.setPower((drive + strafe + turn) / max);
        leftBack.setPower((drive - strafe + turn) / max);
        rightFront.setPower((drive - strafe - turn) / max);
        rightBack.setPower((drive + strafe - turn) / max);

        telemetry.update();
    }
}
